{
  "id": "req_openai_demo",
  "name": "OpenAI标准补全",
  "method": "POST",
  "url": "https://api.openai.com/v1/chat/completions",
  "headers": [
    {
      "key": "Content-Type",
      "value": "application/json",
      "enabled": true,
      "description": ""
    }
  ],
  "params": [],
  "body": {
    "body_type": "json",
    "content": "{\n  \"model\": \"gpt-4o-mini\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Hello! 请简述你的能力\"\n    }\n  ],\n  \"temperature\": 0.7\n}"
  },
  "auth": {
    "auth_type": "bearer",
    "token": "{{openaiApiKey}}"
  },
  "description": "标准 OpenAI / 兼容模型 Chat Completions 接口调用模板"
}
